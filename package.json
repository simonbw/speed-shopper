{
  "name": "speed-shopper",
  "version": "1.0.0",
  "description": "A game where you shop quickly",
  "scripts": {
    "start": "NODE_ENV=development rm -rf .parcel-cache && concurrently -n assets,server \"npm run watch-manifest\" \"npm run dev-server\"",
    "dev-server": "parcel --no-hmr src/index.html",
    "watch-manifest": "tsx ./bin/generate-asset-types.ts -d ./resources watch",
    "build": "parcel build src/index.html",
    "tsc": "tsc --noEmit",
    "tsc-watch": "tsc --noEmit --watch",
    "prettier": "prettier --write src",
    "generate-manifest": "tsx ./bin/generate-asset-types.ts -d ./resources",
    "entity-studio": "parcel src/core/entity-studio/entity-studio.html -p 1235",
    "clean": "rm -rf .parcel-cache; rm -rf dist"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/simonbw/speed-shopper.git"
  },
  "author": "",
  "license": "UNLICENSED",
  "homepage": "https://github.com/simonbw/speed-shopper#readme",
  "dependencies": {
    "@parcel/macros": "^2.12.0",
    "@parcel/resolver-glob": "^2.15.4",
    "@pixi/react": "^7.1.2",
    "@types/node": "^24.0.4",
    "@types/p2": "^0.7.45",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@types/yargs": "^17.0.32",
    "camelcase": "^8.0.0",
    "chokidar": "^4.0.3",
    "concurrently": "^9.2.0",
    "glob": "^11.0.3",
    "p2": "^0.7.1",
    "parcel": "^2.15.4",
    "pixi-filters": "^6.1.3",
    "pixi.js": "^8.10.2",
    "prettier": "^3.6.0",
    "process": "^0.11.10",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "yargs": "^18.0.0"
  },
  "devDependencies": {
    "@picocss/pico": "^2.0.6"
  }
}
